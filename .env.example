# ── Supabase ────────────────────────────────────────────────────────────────
# From your project's API settings. The anon key is safe in the browser;
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No service-role key is needed. Every code path — including the public demo,
# which uses Supabase anonymous auth — acts as a signed-in user and goes
# through RLS. Nothing in this app bypasses it.

# ── AI provider (OpenAI) ────────────────────────────────────────────────────
# Server-side only — never exposed to the browser. Document text is sent to
# this provider for analysis; the UI tells users so.
# If OPENAI_API_KEY is unset, ScopeGuard runs in FIXTURE MODE: the three AI
# operations return pre-labeled deterministic results and the UI says so.
OPENAI_API_KEY=

# Default model for all three operations. gpt-5.6-terra balances capability
# and cost ($2/$12 per MTok); the eval harness reports cost per workflow.
OPENAI_MODEL=gpt-5.6-terra

# Optional per-operation overrides. Operation B (compare) is the product's
# differentiator and benefits most from a stronger model.
#   OPENAI_MODEL_EXTRACT=gpt-5.6-terra
#   OPENAI_MODEL_ANALYZE=gpt-5.6-sol
#   OPENAI_MODEL_DRAFT=gpt-5.6-terra

# Optional: proxy or Azure-compatible gateway.
OPENAI_BASE_URL=

# ── Integrations (all optional) ─────────────────────────────────────────────
# Slack is per-user: with the app credentials below set, each user clicks
# "Connect Slack" and authorizes their own workspace — the bot token is
# stored encrypted per user and only used for their notifications. Create
# the app at api.slack.com/apps with bot token scopes chat:write,
# chat:write.public, channels:read, and add
# <your-origin>/integrations/slack/callback as an OAuth redirect URL.
#   SLACK_CLIENT_ID=…
#   SLACK_CLIENT_SECRET=…

# Encryption key for user OAuth tokens at rest (openssl rand -base64 32).
# Losing it loses the stored connections (users re-connect); it never
# exposes them.
#   INTEGRATION_ENCRYPTION_KEY=…

# Operator-wide fallback (self-hosted single-workspace deployments): used
# only when the acting user has no Slack connection of their own.
#   SLACK_BOT_TOKEN=xoxb-…
#   SLACK_NOTIFY_CHANNEL=#change-orders
# Gmail / CRM / payments are scaffolded — see /integrations in the app for
# exactly what each one needs. Nothing is contacted until its vars are set.

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
